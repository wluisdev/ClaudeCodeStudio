<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="ClaudeStudioExtension.8a6dcdda-70c0-43d0-af04-1e6a25bca67f" Version="1.0" Language="en-US" Publisher="wluisdev" />
    <DisplayName>Claude Code Studio</DisplayName>
    <Description>Claude Code integration for Visual Studio 2022 — chat interface powered by WebView2 with streaming responses, session history, and file attachments.</Description>
    <MoreInfo>https://github.com/wluisdev/ClaudeCodeStudio</MoreInfo>
    <License>LICENSE.txt</License>
    <GettingStartedGuide>https://github.com/wluisdev/ClaudeCodeStudio#readme</GettingStartedGuide>
    <ReleaseNotes>https://github.com/wluisdev/ClaudeCodeStudio/releases</ReleaseNotes>
    <PreviewImage>preview.png</PreviewImage>
    <Tags>Claude, Claude Code, AI, coding assistant, chat, agent, Anthropic, LLM, WebView2</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14, )" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
  </Assets>
</PackageManifest>
