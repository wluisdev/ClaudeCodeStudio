<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AgentToolWindowControl.xaml" />
    <None Remove="ClaudeStudioExtensionPackage.vsct" />
    <None Remove="Ui\app.js" />
    <None Remove="Ui\index.html" />
    <None Remove="Ui\styles.css" />
    <None Remove="Ui\highlight.min.js" />
    <None Remove="Ui\highlight.css" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Ui\app.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Ui\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Ui\styles.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Ui\highlight.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Ui\highlight.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeStudioShared\ClaudeStudioShared.csproj" />
    <!-- Build-order only: the agent (net10.0) must be built before this project packs it into the VSIX. -->
    <ProjectReference Include="..\ClaudeStudioAgent\ClaudeStudioAgent.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="ClaudeStudioExtensionPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <Generator>VsctGenerator</Generator>
    </VSCTCompile>
  </ItemGroup>
  <PropertyGroup>
    <AgentOutputDir>..\ClaudeStudioAgent\bin\$(Configuration)\net10.0\</AgentOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes VS's fast up-to-date check rebuild (and repack the VSIX) when the agent changes. -->
    <UpToDateCheckInput Include="$(AgentOutputDir)ClaudeStudioAgent.exe" />
  </ItemGroup>

  <!-- Expands the agent output glob at build time. A static <Content> glob is expanded when the
       project is evaluated (cached by VS), so after a Clean the VSIX silently packed zero agent
       files even though the agent was rebuilt before this project. -->
  <Target Name="IncludeAgentInVsix" BeforeTargets="AssignTargetPaths;GetVsixSourceItems">
    <Error Condition="!Exists('$(AgentOutputDir)ClaudeStudioAgent.exe')"
           Text="ClaudeStudioAgent.exe not found in $(AgentOutputDir) — build ClaudeStudioAgent first." />
    <ItemGroup>
      <Content Include="$(AgentOutputDir)**\*">
        <Link>ClaudeStudioAgent\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="SyncVsixVersion" BeforeTargets="CreateVsixContainer">
    <XmlPoke
      XmlInputPath="$(IntermediateOutputPath)merged.source.extension.vsixmanifest"
      Query="//*[local-name()='Identity']/@Version"
      Value="$(Version)" />
  </Target>

</Project>